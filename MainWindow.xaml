<Window x:Class="NelayanGo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NelayanGo"
        xmlns:vm="clr-namespace:NelayanGo.ViewModels"
        mc:Ignorable="d"
        Title="NELAYAN GO" Height="700" Width="1000">
    <Window.DataContext>
        <vm:ViewModelsNelayan/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- 0: Header -->
            <RowDefinition Height="*"/>
            <!-- 1: Konten Utama -->
        </Grid.RowDefinitions>

        <!-- === HEADER (ROW 0) === -->
        <Grid Grid.Row="0" Background="#0361A0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="N | NELAYAN GO" Grid.Column="0" Foreground="White" 
                       VerticalAlignment="Center" Margin="20,0,0,0" 
                       FontSize="20" FontWeight="Bold"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                <TextBlock Text="Home" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock Text="Logout" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Binding ke Model Nelayan di dalam ViewModel -->
                    <TextBlock Text="{Binding CurrentNelayan.Nama}" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding CurrentNelayan.KodeIdentik}" Foreground="White" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- === KONTEN UTAMA (ROW 1) === -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kiri: FOTO PROFIL (Placeholder) -->
            <Border Grid.Column="0" Height="200" Width="200" Background="#F0F0F0" 
                    CornerRadius="10" VerticalAlignment="Top" BorderBrush="LightGray" BorderThickness="1">
                <TextBlock Text="Foto Profil" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Kanan: DATA LENGKAP & INFO -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">

                <!-- DATA LENGKAP -->
                <TextBlock Text="DATA LENGKAP" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Grid untuk Data Pribadi (Gunakan Grid sederhana untuk 13 baris data) -->
                <Grid Background="#E6F2FF" Padding="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Definisikan Row untuk 13 data -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BARIS 0: Nama -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text=":"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CurrentNelayan.Nama}" FontWeight="SemiBold"/>

                    <!-- BARIS 1: Kode Identik -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Kode Identik"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text=":"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CurrentNelayan.KodeIdentik}"/>

                    <!-- BARIS 5: NIK -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="NIK"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text=":"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding CurrentNelayan.NIK}"/>

                    <!-- ... Lanjutkan semua 13 binding data pribadi ... -->

                </Grid>

                <!-- === BAGIAN INFO === -->
                <TextBlock Text="INFO" FontSize="18" FontWeight="Bold" Margin="0,30,0,10"/>

                <Grid Background="#0361A0" Height="200">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock" x:Key="InfoNumber">
                            <Setter Property="FontSize" Value="30"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="InfoLabel">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,5,0,0"/>
                        </Style>
                    </Grid.Resources>

                    <!-- ROW 0, COL 0: TOTAL WAKTU AKTIF (HARI) -->
                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource InfoNumber}" Text="{Binding CurrentNelayan.TotalWaktuAktifHari}"/>
                        <TextBlock Style="{StaticResource InfoLabel}" Text="TOTAL WAKTU AKTIF (HARI)"/>
                    </StackPanel>

                    <!-- ROW 0, COL 1: TOTAL JARAK BERLAYAR (KM) -->
                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource InfoNumber}" Text="{Binding CurrentNelayan.TotalJarakBerlayarKM}"/>
                        <TextBlock Style="{StaticResource InfoLabel}" Text="TOTAL JARAK BERLAYAR (KM)"/>
                    </StackPanel>

                    <!-- ROW 1, COL 0: TOTAL JUMLAH BERLAYAR -->
                    <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource InfoNumber}" Text="{Binding CurrentNelayan.TotalJumlahBerlayar}"/>
                        <TextBlock Style="{StaticResource InfoLabel}" Text="TOTAL JUMLAH BERLAYAR"/>
                    </StackPanel>

                    <!-- ... Lanjutkan binding untuk semua metrik info lainnya ... -->

                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
